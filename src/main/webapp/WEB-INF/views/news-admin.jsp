<%@ include file="_layout.jspf" %><div class="eyebrow">PUBLISHING</div><h1 class="h2 mt-2">News management</h1><p class="text-muted">Each edit creates a new content version and an append-only ledger block.</p><section class="tc-card p-4 mb-4"><h2 class="h5"><c:choose><c:when test="${not empty editArticle}">Edit article</c:when><c:otherwise>Add article</c:otherwise></c:choose></h2><form method="post" class="row g-3" action="${ctx}/admin/news"><input type="hidden" name="_csrf" value="${csrf}"><input type="hidden" name="id" value="${editArticle.id}"><div class="col-md-6"><label>Title<input class="form-control mt-1" name="title" maxlength="240" required value="<c:out value='${editArticle.title}'/>"></label></div><div class="col-md-3"><label>Category<select class="form-select mt-1" name="category" required><c:forEach items="${categories}" var="cat"><option value="${cat.id}" <c:if test="${editArticle.categoryId eq cat.id}">selected</c:if>><c:out value="${cat.name}"/></option></c:forEach></select></label></div><div class="col-md-3"><label>Publication date<input class="form-control mt-1" type="date" name="publishedAt" required value="<c:out value='${editArticle.publishedAt}'/>"></label></div><div class="col-md-6"><label>Publisher<input class="form-control mt-1" name="publisher" maxlength="180" required value="<c:out value='${editArticle.publisher}'/>"></label></div><div class="col-12"><label>Description<textarea class="form-control mt-1" name="description" rows="4" maxlength="12000" required><c:out value="${editArticle.description}"/></textarea></label></div><div class="col-12 d-flex gap-2"><button class="btn btn-primary">Save and record version</button><c:if test="${not empty editArticle}"><a href="${ctx}/admin/news" class="btn btn-outline-secondary">Cancel</a></c:if></div></form></section><h2 class="h4 mb-3">Article archive</h2><div class="table-responsive tc-card"><table class="table table-dark table-hover align-middle mb-0"><thead><tr><th>Title</th><th>Category</th><th>Date</th><th>Version</th><th>Status</th><th>Actions</th></tr></thead><tbody><c:forEach items="${articles}" var="a"><tr><td><c:out value="${a.title}"/></td><td><c:out value="${a.categoryName}"/></td><td><c:out value="${a.publishedAt}"/></td><td>v<c:out value="${a.version}"/></td><td><c:out value="${a.deleted?'Deleted':'Published'}"/></td><td class="d-flex gap-2"><c:if test="${not a.deleted}"><a class="btn btn-sm btn-outline-primary" href="${ctx}/admin/news?edit=${a.id}">Edit</a><form method="post" action="${ctx}/admin/news" onsubmit="return confirm('Soft-delete this article? Ledger history is retained.')"><input type="hidden" name="_csrf" value="${csrf}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${a.id}"><button class="btn btn-sm btn-outline-danger">Delete</button></form></c:if><a class="btn btn-sm btn-outline-light" href="${ctx}/verify?id=${a.id}">Verify</a></td></tr></c:forEach></tbody></table></div><%@ include file="_footer.jspf" %>
