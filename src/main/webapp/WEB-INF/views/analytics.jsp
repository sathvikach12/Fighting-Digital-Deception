<%@ include file="_layout.jspf" %><div class="eyebrow">NEWSROOM ANALYTICS</div><h1 class="h2 mt-2">News performance</h1><p class="text-muted">Category totals and most-viewed articles from the local demo dataset.</p><div class="row g-4"><div class="col-lg-6"><section class="tc-card p-4"><h2 class="h5">Articles by category</h2><canvas id="categoryChart" aria-label="Bar chart of article counts by category"></canvas><script type="application/json" id="categoryData"><c:out value="${counts}"/></script><div id="categoryRows" class="mt-3"><c:forEach items="${counts}" var="entry"><div class="d-flex justify-content-between py-1"><span><c:out value="${entry.key}"/></span><strong><c:out value="${entry.value}"/></strong></div></c:forEach></div></section></div><div class="col-lg-6"><section class="tc-card p-4"><h2 class="h5">Popular articles</h2><canvas id="popularChart" aria-label="Bar chart of article views"></canvas><div id="popularData" hidden><c:forEach items="${popular}" var="a"><span data-title="<c:out value='${a.title}'/>" data-views="${a.views}"></span></c:forEach></div><ol class="popular-list mt-3"><c:forEach items="${popular}" var="a"><li><span><c:out value="${a.title}"/></span><small><c:out value="${a.views}"/> views</small></li></c:forEach></ol></section></div></div><script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script><script src="${ctx}/assets/charts.js"></script><%@ include file="_footer.jspf" %>
