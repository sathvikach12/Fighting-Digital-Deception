<%@ include file="_layout.jspf" %><div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><div class="eyebrow">YOUR WORKSPACE</div><h1 class="h2 mt-2">Good to see you, <c:out value="${sessionScope.user.name}"/></h1><p class="text-muted mb-0">A careful look at news starts with a verifiable trail.</p></div><a class="btn btn-primary" href="${ctx}/search">Search the newsroom</a></div>
<c:if test="${sessionScope.user.status eq 'PENDING'}"><div class="alert alert-warning">Your registration is pending admin approval. You can review this profile while you wait.</div></c:if><c:if test="${sessionScope.user.status eq 'INACTIVE'}"><div class="alert alert-danger">This account is inactive. Contact the administrator.</div></c:if>
<c:if test="${sessionScope.user.role eq 'ADMIN'}"><div class="row g-3 mb-4"><div class="col-md-3"><a class="metric-card" href="${ctx}/admin/users"><span>Access</span><strong>User approvals</strong></a></div><div class="col-md-3"><a class="metric-card" href="${ctx}/admin/news"><span>Publishing</span><strong>Manage articles</strong></a></div><div class="col-md-3"><a class="metric-card" href="${ctx}/admin/moderation"><span>Review</span><strong>Moderation queue</strong></a></div><div class="col-md-3"><a class="metric-card" href="${ctx}/ledger"><span>Integrity</span><strong>Inspect ledger</strong></a></div></div></c:if>
<div class="row g-4"><div class="col-lg-8"><div class="d-flex justify-content-between mb-3"><h2 class="h4">Latest articles</h2><span class="text-muted">Cutoff: <c:out value="${quantizationDate}"/></span></div><div class="vstack gap-3"><c:forEach items="${articles}" var="a"><article class="tc-card"><div class="card-body"><div class="d-flex justify-content-between"><span class="badge badge-blue"><c:out value="${a.categoryName}"/></span><c:if test="${a.trending}"><span class="badge badge-green">Current</span></c:if></div><h3 class="h5 mt-3"><c:out value="${a.title}"/></h3><p class="text-muted"><c:out value="${a.description}"/></p><div class="d-flex justify-content-between small text-secondary"><span><c:out value="${a.publisher}"/> · <c:out value="${a.publishedAt}"/></span><span><c:out value="${a.views}"/> views · v<c:out value="${a.version}"/></span></div></div></article></c:forEach><c:if test="${empty articles}"><div class="empty-state">No articles yet. Ask an administrator to add newsroom content.</div></c:if></div></div><div class="col-lg-4"><section class="tc-card p-4"><div class="eyebrow">POPULAR</div><h2 class="h5 mt-2">Most viewed</h2><ol class="popular-list"><c:forEach items="${popular}" var="a"><li><span><c:out value="${a.title}"/></span><small><c:out value="${a.views}"/> views</small></li></c:forEach></ol></section><section class="tc-card p-4 mt-3"><div class="eyebrow">BY CATEGORY</div><h2 class="h5 mt-2">Newsroom mix</h2><c:forEach items="${counts}" var="entry"><div class="d-flex justify-content-between py-2 border-bottom border-secondary-subtle"><span><c:out value="${entry.key}"/></span><strong><c:out value="${entry.value}"/></strong></div></c:forEach></section></div></div>
<%@ include file="_footer.jspf" %>
