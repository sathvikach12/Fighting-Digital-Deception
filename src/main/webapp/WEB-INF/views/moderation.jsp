<%@ include file="_layout.jspf" %><div class="eyebrow">HUMAN REVIEW</div><h1 class="h2 mt-2">Suspicious language review</h1><p class="text-muted">Configured keywords surface possible review candidates. A match is not evidence that a story is false.</p><div class="row g-4"><div class="col-lg-8"><h2 class="h4 mb-3">Needs review</h2><div class="vstack gap-3"><c:forEach items="${queue}" var="item"><article class="tc-card p-4"><div class="eyebrow">MATCHED: <c:out value="${item.matchedKeywords}"/></div><h3 class="h5 mt-2"><c:out value="${item.title}"/></h3><form method="post" action="${ctx}/admin/moderation" class="row g-2"><input type="hidden" name="_csrf" value="${csrf}"><input type="hidden" name="action" value="review"><input type="hidden" name="id" value="${item.articleId}"><div class="col-md-7"><input class="form-control" name="notes" maxlength="1000" placeholder="Review notes (optional)"></div><div class="col-md-3"><select class="form-select" name="decision"><option value="REVIEWED">Mark reviewed</option><option value="CLEAR">Clear flag</option></select></div><div class="col-md-2 d-grid"><button class="btn btn-primary">Save</button></div></form></article></c:forEach><c:if test="${empty queue}"><div class="empty-state">The queue is clear. New matches will appear here.</div></c:if></div></div><div class="col-lg-4"><section class="tc-card p-4"><h2 class="h5">Keyword rules</h2><form method="post" action="${ctx}/admin/moderation" class="vstack gap-2 mb-4"><input type="hidden" name="_csrf" value="${csrf}"><input type="hidden" name="action" value="add"><input class="form-control" name="keyword" maxlength="100" placeholder="Keyword or phrase" required><input class="form-control" name="reason" maxlength="255" placeholder="Why it may merit review"><button class="btn btn-primary">Add keyword</button></form><c:forEach items="${keywords}" var="keyword"><div class="d-flex align-items-center justify-content-between border-top border-secondary-subtle py-2"><span><c:out value="${keyword}"/></span></div></c:forEach></section></div></div><%@ include file="_footer.jspf" %>
