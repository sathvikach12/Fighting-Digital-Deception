<%@ include file="_layout.jspf" %><div class="auth-wrap"><div class="tc-card p-4 p-md-5"><div class="eyebrow">JOIN THE NEWSROOM</div><h1 class="h2 mt-2">Create an account</h1><p class="text-muted">A moderator approves new accounts before search and verification are enabled.</p><form method="post" action="${ctx}/register" class="vstack gap-3"><input type="hidden" name="_csrf" value="${csrf}"><label>Full name<input class="form-control mt-1" name="name" maxlength="120" required autocomplete="name"></label><label>Email<input class="form-control mt-1" type="email" name="email" maxlength="190" required autocomplete="email"></label><label>Password<input class="form-control mt-1" type="password" name="password" minlength="10" maxlength="72" required autocomplete="new-password"><small class="text-muted">Use 10–72 characters.</small></label><button class="btn btn-primary btn-lg">Request access</button></form><p class="mt-4 mb-0 text-muted">Already registered? <a href="${ctx}/login">Sign in</a></p></div></div><%@ include file="_footer.jspf" %>
