<%@ include file="_layout.jspf" %><div class="eyebrow">ACCOUNT</div><h1 class="h2 mt-2">Your profile</h1><section class="tc-card p-4 col-lg-7"><dl class="row mb-0"><dt class="col-sm-4 py-2">Name</dt><dd class="col-sm-8 py-2"><c:out value="${profile.name}"/></dd><dt class="col-sm-4 py-2">Email</dt><dd class="col-sm-8 py-2"><c:out value="${profile.email}"/></dd><dt class="col-sm-4 py-2">Role</dt><dd class="col-sm-8 py-2"><c:out value="${profile.role}"/></dd><dt class="col-sm-4 py-2">Account status</dt><dd class="col-sm-8 py-2"><span class="badge badge-blue"><c:out value="${profile.status}"/></span></dd></dl></section><section class="tc-card p-4 col-lg-7 mt-3"><h2 class="h5">Change password</h2><form method="post" action="${ctx}/profile" class="vstack gap-3"><input type="hidden" name="_csrf" value="${csrf}"><label>Current password<input class="form-control mt-1" type="password" name="currentPassword" required autocomplete="current-password"></label><label>New password<input class="form-control mt-1" type="password" name="newPassword" minlength="10" maxlength="72" required autocomplete="new-password"></label><button class="btn btn-primary align-self-start">Update password</button></form></section><%@ include file="_footer.jspf" %>
