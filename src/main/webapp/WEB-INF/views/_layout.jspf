<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><c:out value="${pageTitle}"/> · TruthChain</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${ctx}/assets/app.css" rel="stylesheet"></head><body>
<nav class="navbar navbar-expand-lg navbar-dark tc-nav"><div class="container"><a class="navbar-brand fw-bold" href="${ctx}/">◈ TruthChain</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
<c:if test="${not empty sessionScope.user}"><li><a class="nav-link" href="${ctx}/dashboard">Overview</a></li><li><a class="nav-link" href="${ctx}/search">Explore</a></li><li><a class="nav-link" href="${ctx}/transactions">My searches</a></li><li><a class="nav-link" href="${ctx}/profile">Profile</a></li><c:if test="${sessionScope.user.role eq 'ADMIN'}"><li class="nav-item dropdown"><a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#">Admin</a><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" href="${ctx}/admin/users">Users</a></li><li><a class="dropdown-item" href="${ctx}/admin/news">News</a></li><li><a class="dropdown-item" href="${ctx}/admin/categories">Categories</a></li><li><a class="dropdown-item" href="${ctx}/admin/moderation">Moderation</a></li><li><a class="dropdown-item" href="${ctx}/admin/settings">Settings</a></li><li><a class="dropdown-item" href="${ctx}/ledger">Ledger</a></li><li><a class="dropdown-item" href="${ctx}/transactions/system">All searches</a></li><li><a class="dropdown-item" href="${ctx}/analytics">Analytics</a></li></ul></li></c:if><li><form method="post" action="${ctx}/logout" class="d-inline"><input type="hidden" name="_csrf" value="${csrf}"><button class="btn btn-sm btn-outline-light">Sign out</button></form></li></c:if>
<c:if test="${empty sessionScope.user}"><li><a class="nav-link" href="${ctx}/login">Sign in</a></li><li><a class="btn btn-sm btn-primary" href="${ctx}/register">Create account</a></li></c:if>
</ul></div></div></nav><main class="container py-4 py-lg-5"><c:if test="${not empty flash}"><div class="alert alert-info" role="status"><c:out value="${flash}"/></div></c:if><c:if test="${not empty dataError}"><div class="alert alert-warning"><c:out value="${dataError}"/></div></c:if>
