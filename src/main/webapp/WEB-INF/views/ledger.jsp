<%@ include file="_layout.jspf" %><div class="eyebrow">INTEGRITY RECORDS</div><h1 class="h2 mt-2">Ledger explorer</h1><p class="text-muted">Centralized append-only SHA-256 hash chain. Verification detects inconsistency within the records available to this application.</p><div class="tc-card p-4 mb-4"><h2 class="h5">Verify an article</h2><form method="get" action="${ctx}/verify" class="row g-2"><div class="col-md-8"><input class="form-control" type="number" min="1" name="id" placeholder="Article ID" value="<c:out value='${verifyId}'/>" required></div><div class="col-md-4 d-grid"><button class="btn btn-primary">Check current content</button></div></form><c:if test="${not empty verifyId}"><div class="alert mt-3 mb-0 ${articleVerified?'alert-success':'alert-danger'}"><c:choose><c:when test="${articleVerified}">Current article content matches its latest recorded fingerprint.</c:when><c:otherwise>No matching article fingerprint was found, or its current content does not match.</c:otherwise></c:choose></div></c:if></div><section class="tc-card p-4 mb-4"><h2 class="h5">Chain verification</h2><c:choose><c:when test="${empty issues}"><span class="badge badge-green">Chain links and block hashes are consistent</span></c:when><c:otherwise><span class="badge badge-amber">Issues detected</span><ul class="mt-3"><c:forEach items="${issues}" var="issue"><li><c:out value="${issue}"/></li></c:forEach></ul></c:otherwise></c:choose></section><div class="table-responsive tc-card"><table class="table table-dark table-hover align-middle mb-0"><thead><tr><th>Index</th><th>Article</th><th>Version</th><th>Timestamp</th><th>Content hash</th><th>Previous hash</th><th>Block hash</th></tr></thead><tbody><c:forEach items="${blocks}" var="b"><tr><td><c:out value="${b.blockIndex}"/></td><td><a href="${ctx}/verify?id=${b.articleId}"><c:out value="${b.title}"/> (#<c:out value="${b.articleId}"/>)</a></td><td>v<c:out value="${b.version}"/></td><td><c:out value="${b.timestamp}"/></td><td><code><c:out value="${b.contentHash}"/></code></td><td><code><c:out value="${b.previousHash}"/></code></td><td><code><c:out value="${b.blockHash}"/></code></td></tr></c:forEach></tbody></table></div><%@ include file="_footer.jspf" %>
