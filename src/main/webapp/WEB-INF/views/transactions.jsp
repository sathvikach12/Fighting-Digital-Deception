<%@ include file="_layout.jspf" %><div class="eyebrow">SEARCH AUDIT</div><h1 class="h2 mt-2"><c:choose><c:when test="${sessionScope.user.role eq 'ADMIN' and pageContext.request.servletPath eq '/transactions/system'}">System search transactions</c:when><c:otherwise>My search history</c:otherwise></c:choose></h1><p class="text-muted">Search terms are saved to support auditability. This page shows the latest 250 records.</p><div class="table-responsive tc-card"><table class="table table-dark table-hover align-middle mb-0"><thead><tr><c:if test="${sessionScope.user.role eq 'ADMIN' and pageContext.request.servletPath eq '/transactions/system'}"><th>User</th></c:if><th>Query</th><th>Category</th><th>Results</th><th>Time</th></tr></thead><tbody><c:forEach items="${records}" var="record"><tr><c:if test="${sessionScope.user.role eq 'ADMIN' and pageContext.request.servletPath eq '/transactions/system'}"><td><c:out value="${record.userName}"/></td></c:if><td><c:out value="${record.query}"/></td><td><c:out value="${record.categoryName}"/></td><td><c:out value="${record.resultCount}"/></td><td><c:out value="${record.searchedAt}"/></td></tr></c:forEach><c:if test="${empty records}"><tr><td colspan="5" class="text-center text-muted py-4">No searches recorded yet.</td></tr></c:if></tbody></table></div><%@ include file="_footer.jspf" %>
