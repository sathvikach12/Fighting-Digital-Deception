<section class="hero rounded-4 p-4 p-lg-5 mb-5"><div class="row align-items-center g-4"><div class="col-lg-8"><span class="eyebrow">TRACEABLE NEWS · HUMAN REVIEW</span><h1 class="display-4 fw-bold mt-3">A clearer trail for the stories we share.</h1><p class="lead text-light-emphasis mt-3">Explore curated news, review suspicious language with context, and verify whether an article’s recorded fingerprint still matches.</p><div class="d-flex gap-2 mt-4"><a class="btn btn-primary btn-lg" href="${ctx}/register">Join the newsroom</a><a class="btn btn-outline-light btn-lg" href="${ctx}/login">Sign in</a></div></div><div class="col-lg-4"><div class="hero-stat"><span class="stat-icon">◈</span><strong>SHA-256</strong><span>Versioned content fingerprints</span><hr><strong>Human-led</strong><span>Keyword flags are review prompts, never truth verdicts</span><hr><strong>Open history</strong><span>Visible edits with linked block hashes</span></div></div></div></section>
<div class="d-flex justify-content-between align-items-end mb-3"><div><div class="eyebrow">THE NEWSROOM</div><h2 class="h3 mt-2">Recently published</h2></div><a href="${ctx}/login" class="link-light">Sign in to search →</a></div><div class="row g-3"><c:forEach items="${articles}" var="a"><div class="col-md-6 col-xl-4"><article class="tc-card h-100"><div class="card-body"><span class="badge badge-blue"><c:out value="${a.categoryName}"/></span><h3 class="h5 mt-3"><c:out value="${a.title}"/></h3><p class="text-muted"><c:out value="${a.description}"/></p><small class="text-secondary"><c:out value="${a.publisher}"/> · <c:out value="${a.publishedAt}"/></small></div></article></div></c:forEach><c:if test="${empty articles}"><div class="col-12"><div class="empty-state">Newsroom articles appear here after the database has been initialized.</div></div></c:if></div>
