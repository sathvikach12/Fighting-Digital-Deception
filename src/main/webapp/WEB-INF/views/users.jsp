<%@ include file="_layout.jspf" %><div class="eyebrow">ACCESS CONTROL</div><h1 class="h2 mt-2">User management</h1><p class="text-muted">Approve pending accounts by activating them. Deactivation preserves account and search history.</p><div class="table-responsive tc-card"><table class="table table-dark table-hover align-middle mb-0"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Joined</th><th>Action</th></tr></thead><tbody><c:forEach items="${users}" var="u"><tr><td><c:out value="${u.name}"/></td><td><c:out value="${u.email}"/></td><td><span class="badge badge-blue"><c:out value="${u.role}"/></span></td><td><c:out value="${u.status}"/></td><td><c:out value="${u.createdAt}"/></td><td><c:if test="${u.role eq 'USER'}"><form method="post" action="${ctx}/admin/users" class="d-flex gap-2"><input type="hidden" name="_csrf" value="${csrf}"><input type="hidden" name="id" value="${u.id}"><c:choose><c:when test="${u.status eq 'ACTIVE'}"><input type="hidden" name="status" value="INACTIVE"><button class="btn btn-sm btn-outline-danger">Deactivate</button></c:when><c:otherwise><input type="hidden" name="status" value="ACTIVE"><button class="btn btn-sm btn-primary">Approve / activate</button></c:otherwise></c:choose></form></c:if></td></tr></c:forEach></tbody></table></div><%@ include file="_footer.jspf" %>
