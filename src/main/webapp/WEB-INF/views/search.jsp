<%@ include file="_layout.jspf" %><div class="eyebrow">NEWSROOM SEARCH</div><h1 class="h2 mt-2">Find a story</h1><p class="text-muted">Search titles and descriptions. A keyword flag requests human review; it does not label a story false.</p><form method="get" action="${ctx}/search" class="tc-card p-3 mb-4"><div class="row g-2"><div class="col-md-7"><input class="form-control" name="q" value="${fn:escapeXml(query)}" placeholder="Search topics, claims, publishers…" maxlength="255"></div><div class="col-md-3"><select class="form-select" name="category"><option value="">All categories</option><c:forEach items="${categories}" var="cat"><option value="${cat.id}" <c:if test="${selectedCategory eq cat.id}">selected</c:if>><c:out value="${cat.name}"/></option></c:forEach></select></div><div class="col-md-2 d-grid"><button class="btn btn-primary">Search</button></div></div></form><div class="row g-3"><c:forEach items="${articles}" var="a"><div class="col-lg-6"><article class="tc-card h-100"><div class="card-body"><div class="d-flex justify-content-between"><span class="badge badge-blue"><c:out value="${a.categoryName}"/></span><span class="badge <c:choose><c:when test='${a.moderationStatus eq "NEEDS_REVIEW"}'>badge-amber</c:when><c:otherwise>badge-green</c:otherwise></c:choose>"><c:out value="${a.moderationStatus eq 'NEEDS_REVIEW'?'Review requested':'No keyword flag'}"/></span></div><h2 class="h5 mt-3"><c:out value="${a.title}"/></h2><p class="text-muted"><c:out value="${a.description}"/></p><div class="small text-secondary"><c:out value="${a.publisher}"/> · <c:out value="${a.publishedAt}"/> · <c:out value="${a.views}"/> views · v<c:out value="${a.version}"/></div><a class="btn btn-sm btn-outline-primary mt-3" href="${ctx}/search?id=${a.id}&amp;q=${fn:escapeXml(query)}&amp;category=${selectedCategory}">Verify fingerprint</a></div></article></div></c:forEach><c:if test="${empty articles}"><div class="col-12"><div class="empty-state">No matching stories. Try another title, description keyword, or category.</div></div></c:if></div><%@ include file="_footer.jspf" %>
