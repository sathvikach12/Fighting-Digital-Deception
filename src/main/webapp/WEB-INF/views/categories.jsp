<%@ include file="_layout.jspf" %><div class="eyebrow">TAXONOMY</div><h1 class="h2 mt-2">News categories</h1><section class="tc-card p-4 my-4"><form method="post" action="${ctx}/admin/categories" class="row g-2"><input type="hidden" name="_csrf" value="${csrf}"><div class="col-md-4"><input class="form-control" name="name" maxlength="80" placeholder="Category name" required></div><div class="col-md-6"><input class="form-control" name="description" maxlength="500" placeholder="Short description"></div><div class="col-md-2 d-grid"><button class="btn btn-primary">Add category</button></div></form></section><div class="row g-3"><c:forEach items="${categories}" var="cat"><div class="col-md-6 col-xl-4"><div class="tc-card p-4 h-100"><div class="d-flex justify-content-between"><h2 class="h5"><c:out value="${cat.name}"/></h2><form method="post" action="${ctx}/admin/categories"><input type="hidden" name="_csrf" value="${csrf}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${cat.id}"><button class="btn btn-sm btn-outline-danger">Remove</button></form></div><p class="text-muted mb-0"><c:out value="${cat.description}"/></p></div></div></c:forEach></div><%@ include file="_footer.jspf" %>
